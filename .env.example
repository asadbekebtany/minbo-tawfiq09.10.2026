# ═══════════════════════════════════════════════════════════════════════════════
# DIQQAT: .env faylini git repoga yoki ZIP/archive ga QO‘SHMANG.
# Faqat shu .env.example (va .env.*.example) shablonlari commit qilinadi.
# Local setup: npm run env:setup
# Xavfsizlik: docs/env-security.md
# ═══════════════════════════════════════════════════════════════════════════════

# ─── MUHIT (APP_ENV) ─────────────────────────────────────────────────────────
# development | staging | production
# NODE_ENV dan alohida — deployment siyosati shu orqali boshqariladi.
# Batafsil: docs/environments.md
APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"

# Stagingda vaqtinchalik OTP demo (faqat SMS yo'q bo'lsa)
ALLOW_STAGING_OTP_DEMO="false"

# ─── DATABASE ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tavfiq?schema=public"
# Pooled URL (Neon/Supabase) ishlatilsa, to‘g‘ridan-to‘g‘ri ulanish:
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tavfiq?schema=public"
#
# Test/integration (destructive cleanup faqat shu DB da):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tavfiq_test?schema=public"

# Tez ishga tushirish (Docker Desktop o‘rnatilgan bo‘lsa):
#   npm run db:setup
# Bu buyruq PostgreSQL konteynerini ishga tushiradi, migration va seed bajaradi.
# Eski `mavlon` DB nomi ishlatilgan bo‘lsa: docker compose down -v && npm run db:setup
#
# Qo‘lda:
#   npm run db:up
#   npm run db:migrate
#   npm run db:seed
#
# Migration tekshiruvi:
#   npm run db:migrate:check-offline   # DBsiz (CI)
#   npm run db:migrate:verify           # deploy + drift (PostgreSQL kerak)
#
# Schema validatsiyasi:
#   npm run db:validate
#
# Seed rejimi: development (demo katalog) | production (faqat CMS + super admin)
SEED_MODE="development"
#
# Development (local, demo loginlar bilan):
#   npm run db:seed:dev
#
# Production/staging (demo mahsulot va xaridorlarsiz):
#   npm run db:seed:prod
#
# Eski alias:
#   npm run db:seed
#
# Yangi foydalanuvchilar OTP orqali kirganda avtomatik User jadvaliga yoziladi.
# DATABASE_URL bo‘lmasa yoki PostgreSQL ishlamasa, faqat vaqtinchalik demo sessiya ishlaydi.
#
# Migration tartibi:
#   1. 20260624000000_init_schema — to‘liq sxema
#   2. 20260625010000_restore_hero_and_site_settings — idempotent patch
#   3. 20260625120000_brand_name_tavfiq — TAVFIQ brend defaultlari
#   4. 20260626120000_phone_otp — SMS OTP saqlash jadvali
#   5. 20260626140000_auth_rate_limit — auth rate limit hodisalari

# ─── NEXTAUTH ────────────────────────────────────────────────────────────────
# Minimum 32 belgidan iborat tasodifiy kalit
# Yaratish: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-minimum-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# ─── CLOUDINARY (rasm yuklash) ───────────────────────────────────────────────
# https://cloudinary.com — bepul 25GB/oy
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── PAYME (to'lov) ──────────────────────────────────────────────────────────
# https://payme.uz/developers — credential keyin ulanadi, hozir bo‘sh
PAYME_MERCHANT_ID=""
PAYME_KEY=""
PAYME_TEST_KEY=""
PAYME_SECRET_KEY=""
PAYME_TEST_SECRET_KEY=""
PAYME_RETURN_URL=""
PAYME_ENV="test"
PAYME_ENABLED="true"

# ─── CLICK (to'lov) ──────────────────────────────────────────────────────────
# https://click.uz/developers — credential keyin ulanadi
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET=""
CLICK_SECRET_KEY=""
CLICK_WEBHOOK_SECRET=""
CLICK_RETURN_URL=""
CLICK_MERCHANT_USER_ID=""
CLICK_ENABLED="true"

# ─── SMS OTP ─────────────────────────────────────────────────────────────────
# Eskiz: SMS_PROVIDER=eskiz | demo: mock (productionda mock taqiqlangan)
SMS_PROVIDER="auto"
SMS_API_URL="https://notify.eskiz.uz/api"
SMS_LOGIN=""
SMS_PASSWORD=""
SMS_API_EMAIL=""
SMS_API_PASSWORD=""
SMS_SENDER_NAME="TAVFIQ"
# Demo rejim: SMS integratsiyasi yo‘q bo‘lganda ishlatiladi
# Productionda BO‘SH qoldiring. Demo auth productionda ishlamaydi.
OTP_DEMO_CODES="1234"
# OTP amal qilish muddati (daqiqa) va qayta yuborish oralig‘i (soniya)
OTP_TTL_MINUTES="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_VERIFY_ATTEMPTS="5"

# Rate limit — IP va telefon bo‘yicha (spam va brute-force himoyasi)
OTP_SEND_IP_MAX="10"
OTP_SEND_IP_WINDOW_MINUTES="60"
OTP_SEND_PHONE_MAX="5"
OTP_SEND_PHONE_WINDOW_MINUTES="60"
OTP_VERIFY_IP_MAX="30"
OTP_VERIFY_IP_WINDOW_MINUTES="15"
OTP_VERIFY_PHONE_MAX="15"
OTP_VERIFY_PHONE_WINDOW_MINUTES="15"
AUTH_SIGNIN_IP_MAX="20"
AUTH_SIGNIN_IP_WINDOW_MINUTES="15"
AUTH_SIGNIN_PHONE_MAX="10"
AUTH_SIGNIN_PHONE_WINDOW_MINUTES="15"

# ─── APP ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TAVFIQ"

# Admin API demo rejimi. Haqiqiy productionda session/permission qo‘shib true qiling.
LOCK_ADMIN_API="false"

# Payment feature flags (mock providers. Real Click/Payme hali ulanmagan)
PAYME_ENABLED="true"
CLICK_ENABLED="true"

# Logistics / payout (internal; real carrier/bank keyin setLogisticsProvider / setPayoutProvider)
LOGISTICS_PROVIDER="internal"
LOGISTICS_WEBHOOK_SECRET=""
PAYOUT_PROVIDER="internal"
PAYOUT_WEBHOOK_SECRET=""

# Storage: local disk. Default: data/uploads (gitignore, deploy overwrite qilmaydi).
# Production VPS: LOCAL_UPLOAD_DIR=/var/lib/tavfiq/uploads
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR=""

