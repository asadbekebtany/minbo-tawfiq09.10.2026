# Production — faqat deploy platform secret store (Vercel/Docker/VPS)

APP_ENV="production"
NEXT_PUBLIC_APP_ENV="production"
ALLOW_STAGING_OTP_DEMO="false"

DATABASE_URL="postgresql://tavfiq:CHANGE_ME@prod-db-host:5432/tavfiq?schema=public&sslmode=require"
# DIRECT_URL="postgresql://tavfiq:CHANGE_ME@prod-db-host:5432/tavfiq?schema=public&sslmode=require"
SEED_MODE="production"

NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://tavfiq.uz"
# Reverse proxy: lib/auth.ts trustHost=true (Host / X-Forwarded-* ishonchli)

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

PAYME_MERCHANT_ID=""
PAYME_KEY=""
PAYME_TEST_KEY=""
PAYME_SECRET_KEY=""
PAYME_TEST_SECRET_KEY=""
PAYME_RETURN_URL="https://tavfiq.uz/profile/orders"
PAYME_ENV="production"
PAYME_ENABLED="true"

CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET=""
CLICK_SECRET_KEY=""
CLICK_WEBHOOK_SECRET=""
CLICK_RETURN_URL="https://tavfiq.uz/profile/orders"
CLICK_MERCHANT_USER_ID=""
CLICK_ENABLED="true"

SMS_PROVIDER="eskiz"
SMS_API_URL="https://notify.eskiz.uz/api"
SMS_LOGIN=""
SMS_PASSWORD=""
SMS_API_EMAIL=""
SMS_API_PASSWORD=""
SMS_SENDER_NAME="TAVFIQ"
OTP_DEMO_CODES=""
OTP_TTL_MINUTES="5"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_VERIFY_ATTEMPTS="5"

OTP_SEND_IP_MAX="10"
OTP_SEND_IP_WINDOW_MINUTES="60"
OTP_SEND_PHONE_MAX="5"
OTP_SEND_PHONE_WINDOW_MINUTES="60"
OTP_VERIFY_IP_MAX="30"
OTP_VERIFY_IP_WINDOW_MINUTES="15"
OTP_VERIFY_PHONE_MAX="15"
OTP_VERIFY_PHONE_WINDOW_MINUTES="15"
AUTH_SIGNIN_IP_MAX="20"
AUTH_SIGNIN_IP_WINDOW_MINUTES="15"
AUTH_SIGNIN_PHONE_MAX="10"
AUTH_SIGNIN_PHONE_WINDOW_MINUTES="15"

NEXT_PUBLIC_APP_URL="https://tavfiq.uz"
NEXT_PUBLIC_APP_NAME="TAVFIQ"
LOCK_ADMIN_API="false"
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="/var/lib/tavfiq/uploads"
LOGISTICS_PROVIDER="internal"
