# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — faqat *.example shablonlari commit qilinadi
.env
.env.*
!.env.example
!.env.*.example
.envrc
*.env.backup
*.env.bak
# Eski nomlar (backward compat)
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# local image storage (keep folder, ignore files)
/public/uploads/**
!/public/uploads/.gitkeep
/data/uploads/**
!/data/uploads/.gitkeep
/data/backups/
/logs/

