# TAVFIQ reverse proxy (nginx). SSL — Let's Encrypt / certbot.
# server_name va proxy_pass ni o‘z VPS qiymatlaringizga almashtiring.

upstream tavfiq_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name tavfiq.uz www.tavfiq.uz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tavfiq.uz www.tavfiq.uz;

    # ssl_certificate     /etc/letsencrypt/live/tavfiq.uz/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/tavfiq.uz/privkey.pem;

    client_max_body_size 6m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    location = /api/health {
        proxy_pass http://tavfiq_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        access_log off;
    }

    location = /api/health/db {
        proxy_pass http://tavfiq_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        access_log off;
    }

    location / {
        proxy_pass http://tavfiq_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
