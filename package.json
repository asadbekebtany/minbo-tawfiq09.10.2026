{
  "name": "tavfiq-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "prestart": "node scripts/ensure-runtime-dirs.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/register-aliases.mjs --test lib/order-state.test.ts lib/pvz-state.test.ts lib/post-login-path.test.ts lib/return-state.test.ts lib/date-range.test.ts lib/commerce/ledger.test.ts lib/permissions.test.ts lib/db-safety.test.ts lib/runtime-policy.test.ts lib/upload-dir.test.ts lib/providers/provider-readiness.test.ts tests/integration/marketplace.test.ts",
    "jobs:expire-orders": "node --experimental-strip-types scripts/expire-pending-orders.ts",
    "env:validate": "node scripts/validate-env.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "env:check-secrets": "node scripts/check-env-security.mjs",
    "ci": "npm run env:check-secrets && npm run env:validate && npm run db:validate && npm run db:migrate:check-offline && npx prisma generate && npm run lint && npm run build",
    "seed": "prisma db seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:check-offline": "node scripts/validate-migration-files.mjs",
    "db:migrate:verify": "node scripts/verify-migrations.mjs",
    "db:validate": "prisma validate",
    "db:seed": "node scripts/run-seed.mjs development",
    "db:seed:dev": "node scripts/run-seed.mjs development",
    "db:seed:prod": "node scripts/run-seed.mjs production",
    "db:setup": "node scripts/db-setup.mjs",
    "db:ping": "node scripts/db-ping.mjs",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.16",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "react-hot-toast": "^2.6.0",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
